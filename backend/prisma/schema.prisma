generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ChatSession {
  id        Int      @id @default(autoincrement())
  users_id  Int
  role_type String   @default("employee") // "employee" or "employer" or "admin"
  title     String?
  thread_id String   @unique // OpenAI thread ID (messages stored in OpenAI)
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

